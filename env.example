# Application
NODE_ENV=development
PORT=3000

# Database
# For Docker: use 'postgres' as host (service name)
# For local development: use 'localhost'
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=nest_sql_template
POSTGRES_SSLMODE=disable
# Verification defaults to true for verify-ca/verify-full. Optional PEM values:
# POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# POSTGRES_SSL_CA=
# POSTGRES_SSL_CERT=
# POSTGRES_SSL_KEY=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# SMTP email (enable after supplying host/from; authentication is optional for local relays)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for STARTTLS on port 587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# Termii SMS (use your account's base URL, without /api/sms/send)
TERMII_ENABLED=false
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=
# dnd for transactional messages; generic for promotional messages
TERMII_CHANNEL=dnd
TERMII_TIMEOUT_MS=10000

# Payments (provider credentials are required when using payments)
PAYMENT_PROVIDER=paystack
# Amounts are integer subunits: 10000 = NGN 100.00
PAYMENT_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
# Set your whsec_ signing secret for timestamped Paystack-Signature verification.
# When empty, legacy x-paystack-signature is verified using PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
PAYSTACK_TIMEOUT_MS=10000
